DATA_BLOCK "AnalogState04"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR
    Enabled : Bool := FALSE;
    RawIn0 : Int := 0;
    RawIn1 : Int := 0;
    RawIn2 : Int := 0;
    RawIn3 : Int := 0;
    InRange0 : Bool := FALSE;
    InRange1 : Bool := FALSE;
    InRange2 : Bool := FALSE;
    InRange3 : Bool := FALSE;
    ScaledIn0 : DInt := 0;
    ScaledIn1 : DInt := 0;
    ScaledIn2 : DInt := 0;
    ScaledIn3 : DInt := 0;
    CommandEU0 : DInt := 0;
    CommandEU1 : DInt := 0;
    RawOut0 : Int := 0;
    RawOut1 : Int := 0;
END_VAR
BEGIN
END_DATA_BLOCK

FUNCTION "AnalogCycle04" : Void
VERSION : 0.1
VAR_TEMP
    Value : DInt;
END_VAR
BEGIN
    "AnalogState04".Enabled := %I0.0;
    "AnalogState04".RawIn0 := %IW96;
    "AnalogState04".InRange0 := ("AnalogState04".RawIn0 >= -27648) AND ("AnalogState04".RawIn0 <= 27648);
    #Value := INT_TO_DINT("AnalogState04".RawIn0);
    IF #Value < -27648 THEN #Value := -27648; END_IF;
    IF #Value > 27648 THEN #Value := 27648; END_IF;
    "AnalogState04".ScaledIn0 := (#Value * 1000) / 27648;
    "AnalogState04".RawIn1 := %IW98;
    "AnalogState04".InRange1 := ("AnalogState04".RawIn1 >= -27648) AND ("AnalogState04".RawIn1 <= 27648);
    #Value := INT_TO_DINT("AnalogState04".RawIn1);
    IF #Value < -27648 THEN #Value := -27648; END_IF;
    IF #Value > 27648 THEN #Value := 27648; END_IF;
    "AnalogState04".ScaledIn1 := (#Value * 1000) / 27648;
    "AnalogState04".RawIn2 := %IW100;
    "AnalogState04".InRange2 := ("AnalogState04".RawIn2 >= -27648) AND ("AnalogState04".RawIn2 <= 27648);
    #Value := INT_TO_DINT("AnalogState04".RawIn2);
    IF #Value < -27648 THEN #Value := -27648; END_IF;
    IF #Value > 27648 THEN #Value := 27648; END_IF;
    "AnalogState04".ScaledIn2 := (#Value * 1000) / 27648;
    "AnalogState04".RawIn3 := %IW102;
    "AnalogState04".InRange3 := ("AnalogState04".RawIn3 >= -27648) AND ("AnalogState04".RawIn3 <= 27648);
    #Value := INT_TO_DINT("AnalogState04".RawIn3);
    IF #Value < -27648 THEN #Value := -27648; END_IF;
    IF #Value > 27648 THEN #Value := 27648; END_IF;
    "AnalogState04".ScaledIn3 := (#Value * 1000) / 27648;
    #Value := "AnalogState04".CommandEU0;
    IF #Value < -1000 THEN #Value := -1000; END_IF;
    IF #Value > 1000 THEN #Value := 1000; END_IF;
    #Value := (#Value * 27648) / 1000;
    IF NOT "AnalogState04".Enabled THEN #Value := 0; END_IF;
    "AnalogState04".RawOut0 := DINT_TO_INT(#Value);
    %QW112 := "AnalogState04".RawOut0;
    #Value := "AnalogState04".CommandEU1;
    IF #Value < -1000 THEN #Value := -1000; END_IF;
    IF #Value > 1000 THEN #Value := 1000; END_IF;
    #Value := (#Value * 27648) / 1000;
    IF NOT "AnalogState04".Enabled THEN #Value := 0; END_IF;
    "AnalogState04".RawOut1 := DINT_TO_INT(#Value);
    %QW114 := "AnalogState04".RawOut1;
END_FUNCTION
