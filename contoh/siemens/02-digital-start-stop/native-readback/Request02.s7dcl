{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
}
FUNCTION "Request02" : Void

    {
      S7_Language := "LAD"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( "State02".Armed )
            wire#w1
            Contact( "State02".StopHealthy )
            Contact( "State02".EStopHealthy )
            Coil( "State02".Armed )
        END_RUNG
        RUNG wire#powerrail
            I_Contact( "State02".StartPB )
        END_RUNG wire#w1

    END_NETWORK

    {
      S7_Language := "LAD"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( "State02".RunRequest )
            wire#w1
            Contact( "State02".StopHealthy )
            Contact( "State02".EStopHealthy )
            Coil( "State02".RunRequest )
        END_RUNG
        RUNG wire#powerrail
            Contact( "State02".StartPB )
            Contact( "State02".Armed )
        END_RUNG wire#w1

    END_NETWORK

END_FUNCTION
