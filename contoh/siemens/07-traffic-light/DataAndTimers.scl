    Stage0 : Bool := FALSE;
    Stage1 : Bool := FALSE;
    Stage2 : Bool := FALSE;
    Stage3 : Bool := FALSE;
    Stage4 : Bool := FALSE;
    Stage5 : Bool := FALSE;
    Stage6 : Bool := FALSE;
    Stage7 : Bool := FALSE;
    Hold0 : Bool := FALSE;
    Hold1 : Bool := FALSE;
    Hold2 : Bool := FALSE;
    Hold3 : Bool := FALSE;
    Hold4 : Bool := FALSE;
    Hold5 : Bool := FALSE;
    Hold6 : Bool := FALSE;
    Hold7 : Bool := FALSE;
    Advance0 : Bool := FALSE;
    Advance1 : Bool := FALSE;
    Advance2 : Bool := FALSE;
    Advance3 : Bool := FALSE;
    Advance4 : Bool := FALSE;
    Advance5 : Bool := FALSE;
    Advance6 : Bool := FALSE;
    Advance7 : Bool := FALSE;
    NSGreenPermit : Bool := FALSE;
    NSYellowPermit : Bool := FALSE;
    EWGreenPermit : Bool := FALSE;
    EWYellowPermit : Bool := FALSE;
    PedGreenPermit : Bool := FALSE;
    NorthRed : Bool := FALSE;
    NorthYellow : Bool := FALSE;
    NorthGreen : Bool := FALSE;
    SouthRed : Bool := FALSE;
    SouthYellow : Bool := FALSE;
