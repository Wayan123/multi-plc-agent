{
  "schema_version": 1,
  "id": "02-cp1h-xa40dt-d",
  "model": "CP1H-XA40DT-D",
  "device": "CP1H",
  "cpu": "XA",
  "sections": [
    {
      "name": "Motor_Prestart_Control",
      "rungs": [
        {
          "comment": "Request seal-in; Stop, permissive loss, and first cycle always override Start and self-hold.",
          "instructions": [
            "LD 0.00",
            "AND W0.01",
            "OR W0.00",
            "AND 0.01",
            "AND 1.00",
            "ANDNOT A200.11",
            "OUT W0.00"
          ]
        },
        {
          "comment": "Arm only after Start is released while ready; clear while the request is active.",
          "instructions": [
            "LDNOT 0.00",
            "OR W0.01",
            "AND 0.01",
            "AND 1.00",
            "ANDNOT W0.00",
            "ANDNOT A200.11",
            "OUT W0.01"
          ]
        },
        {
          "comment": "TIM uses BCD preset 0030 x 0.1 s = 3 s; loss of the request resets the timer.",
          "instructions": [
            "LD W0.00",
            "TIM 0000 #0030"
          ]
        },
        {
          "comment": "Horn only during prestart; one writer for the physical horn output.",
          "instructions": [
            "LD W0.00",
            "ANDNOT T0000",
            "OUT 100.00"
          ]
        },
        {
          "comment": "Motor only after the timer completes; one writer for the physical motor output.",
          "instructions": [
            "LD W0.00",
            "AND T0000",
            "OUT 101.00"
          ]
        }
      ]
    }
  ],
