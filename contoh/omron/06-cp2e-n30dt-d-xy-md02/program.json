{
  "schema_version": 1,
  "id": "cp2e-n30-xy-md02",
  "model": "CP2E-N30DT-D",
  "device": "CP2E-N",
  "cpu": "N",
  "sections": [
    {
      "name": "XY_MD02",
      "rungs": [
        {
          "comment": "Startup: reset application state, never reset the system execution bit",
          "instructions": [
            "LD A200.11",
            "MOV(021) #0000 D100",
            "MOV(021) #0000 D101",
            "MOV(021) #0000 D102",
            "MOV(021) #0000 D103"
          ]
        },
        {
          "comment": "Mask byte count without modifying the live response",
          "instructions": [
            "LD P_On",
            "ANDW(034) D1254 #FF00 D114"
          ]
        },
        {
          "comment": "Owned completion is evaluated BEFORE any new request",
          "instructions": [
            "LD W20.00",
            "ANDNOT A640.00",
            "ANDNOT A200.11",
            "OUT W21.00"
          ]
        },
        {
          "comment": "Validate success flags, ID, function, length and byte count",
          "instructions": [
            "LD W21.00",
            "AND A640.01",
            "ANDNOT A640.02",
            "AND=(300) D1250 #0001",
            "AND=(300) D1251 #0004",
            "AND=(300) D1252 #0000",
            "AND=(300) D1253 #0005",
            "AND=(300) D114 #0400",
            "OUT W21.01"
          ]
        },
        {
          "comment": "Completed but not valid: includes protocol shape errors",
          "instructions": [
            "LD W21.00",
            "ANDNOT W21.01",
            "OUT W21.02"
          ]
        },
        {
          "comment": "Preserve raw Omron execution error separately",
          "instructions": [
            "LD W21.00",
            "MOV(021) D1252 D102"
          ]
        },
        {
          "comment": "Assemble signed temperature and humidity from fresh scratch bytes",
          "instructions": [
            "LD W21.01",
            "ANDW(034) D1254 #00FF D110",
            "SWAP(637) &1 D110",
            "ANDW(034) D1255 #FF00 D111",
            "SWAP(637) &1 D111",
            "ORW(035) D110 D111 D100",
            "ANDW(034) D1255 #00FF D112",
            "SWAP(637) &1 D112",
            "ANDW(034) D1256 #FF00 D113",
            "SWAP(637) &1 D113",
            "ORW(035) D112 D113 D101",
            "MOV(021) #0000 D103"
          ]
        },
        {
          "comment": "Application response or completion validation error; not an Omron error code",
          "instructions": [
            "LD W21.02",
            "ANDNOT A640.02",
            "MOV(021) #0001 D103"
          ]
        },
        {
          "comment": "A system-reported slave or transport error is not an application validation error",
          "instructions": [
            "LD W21.02",
            "AND A640.02",
            "MOV(021) #0000 D103"
          ]
        },
        {
          "comment": "Wait one second BETWEEN completed requests; do not overlap the 5s system timeout",
          "instructions": [
            "LD W10.00",
            "ANDNOT W20.00",
            "ANDNOT W21.00",
            "TIM 0001 #0010"
          ]
        },
        {
          "comment": "Start only when application AND system are idle",
          "instructions": [
            "LD W10.00",
            "AND T0001",
            "ANDNOT W20.00",
            "ANDNOT A640.00",
            "ANDNOT A200.11",
            "OUT W21.03"
          ]
        },
        {
          "comment": "FC04 input-register read: wire start 0001 quantity 0002, CRC generated by PLC",
          "instructions": [
            "LD W21.03",
            "MOV(021) #0000 D103",
            "MOV(021) #0001 D1200",
            "MOV(021) #0004 D1201",
            "MOV(021) #0004 D1202",
            "MOV(021) #0001 D1203",
            "MOV(021) #0002 D1204",
            "SET A640.00"
          ]
        },
        {
          "comment": "One writer: owned transaction next state",
          "instructions": [
            "LD W20.00",
            "ANDNOT W21.00",
            "OR W21.03",
            "ANDNOT A200.11",
            "OUT W20.00"
          ]
        },
        {
          "comment": "One writer: fresh values valid only after success and while enabled",
          "instructions": [
            "LD W20.01",
            "OR W21.01",
            "ANDNOT W21.02",
            "ANDNOT W21.03",
            "AND W10.00",
            "ANDNOT A200.11",
            "OUT W20.01"
          ]
        },
        {
          "comment": "One writer: retain last failure until next poll",
          "instructions": [
            "LD W20.02",
            "OR W21.02",
            "ANDNOT W21.03",
            "ANDNOT A200.11",
            "OUT W20.02"
          ]
        }
      ]
    }
  ],
  "scenarios": [
    {
      "name": "normal_completion_then_disable_marks_last_good_stale",
      "scans": [
        {
          "inputs": {
            "W10.00": true
