            "A640.01": true
          },
          "dt_ms": 1000,
          "expect": {
            "A640.00": true,
            "W20.00": true,
            "W20.01": false,
            "D1200": 1,
            "D1201": 4,
            "D1202": 4,
            "D1203": 1,
            "D1204": 2
          }
        },
        {
          "inputs": {
            "A640.00": true
          },
          "expect": {
            "W20.01": false,
            "D100": 0
          }
        },
        {
          "inputs": {
            "A640.00": false,
            "A640.01": true,
            "A640.02": false,
            "D1250": 1,
            "D1251": 4,
            "D1252": 0,
            "D1253": 5,
            "D1254": 1025,
            "D1255": 12546,
            "D1256": 8871
          },
          "expect": {
            "D100": 305,
            "D101": 546,
            "W20.01": true,
            "W20.02": false,
            "W20.00": false
          }
        },
        {
          "inputs": {
            "W10.00": false
          },
          "expect": {
            "W20.01": false,
            "D100": 305
          }
        }
      ]
    },
