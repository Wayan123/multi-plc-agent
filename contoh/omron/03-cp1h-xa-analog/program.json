{
  "schema_version": 1,
  "id": "03-cp1h-xa-analog",
  "model": "CP1H-XA40DT-D",
  "device": "CP1H",
  "cpu": "XA",
  "sections": [
    {
      "name": "Analog_Validity",
      "rungs": [
        {
          "comment": "Valid AI0: ready, not first scan/error/#8000.",
          "instructions": [
            "LD A434.04",
            "ANDNOT A315.14",
            "ANDNOT A200.11",
            "AND<>(305) 200 #8000",
            "OUT W0.00"
          ]
        },
        {
          "comment": "Valid AI1: ready, not first scan/error/#8000; reject open circuit.",
          "instructions": [
            "LD A434.04",
            "ANDNOT A315.14",
            "ANDNOT A200.11",
            "AND<>(305) 201 #8000",
            "ANDNOT A434.01",
            "OUT W0.01"
          ]
        },
        {
          "comment": "Valid AI2: ready, not first scan/error/#8000.",
          "instructions": [
            "LD A434.04",
            "ANDNOT A315.14",
            "ANDNOT A200.11",
            "AND<>(305) 202 #8000",
            "OUT W0.02"
          ]
        },
        {
          "comment": "Valid AI3: ready, not first scan/error/#8000; reject open circuit.",
          "instructions": [
            "LD A434.04",
            "ANDNOT A315.14",
            "ANDNOT A200.11",
            "AND<>(305) 203 #8000",
            "ANDNOT A434.03",
            "OUT W0.03"
          ]
        },
        {
          "comment": "All AI channels must be valid to enable both AO channels; a fault on either channel drives both low.",
          "instructions": [
            "LD W0.00",
            "AND W0.01",
            "AND W0.02",
            "AND W0.03",
            "OUT W0.04"
          ]
        }
      ]
    },
    {
      "name": "HMI_Input_Publication",
      "rungs": [
        {
          "comment": "Clear the AI0 published value every scan; invalid data does not remain as a valid value.",
          "instructions": [
            "LD P_On",
            "MOV(021) &0 D100"
          ]
        },
        {
          "comment": "Copy AI0 only when validity is ON.",
          "instructions": [
            "LD W0.00",
            "MOV(021) 200 D100"
          ]
        },
        {
          "comment": "Clear the AI1 published value every scan; invalid data does not remain as a valid value.",
          "instructions": [
            "LD P_On",
            "MOV(021) &0 D101"
          ]
        },
        {
          "comment": "Copy AI1 only when validity is ON.",
          "instructions": [
            "LD W0.01",
            "MOV(021) 201 D101"
          ]
        },
        {
          "comment": "Clear the AI2 published value every scan; invalid data does not remain as a valid value.",
          "instructions": [
            "LD P_On",
            "MOV(021) &0 D102"
          ]
        },
        {
          "comment": "Copy AI2 only when validity is ON.",
          "instructions": [
            "LD W0.02",
            "MOV(021) 202 D102"
          ]
        },
        {
          "comment": "Clear the AI3 published value every scan; invalid data does not remain as a valid value.",
          "instructions": [
            "LD P_On",
            "MOV(021) &0 D103"
          ]
        },
        {
          "comment": "Copy AI3 only when validity is ON.",
          "instructions": [
            "LD W0.03",
            "MOV(021) 203 D103"
          ]
        }
      ]
    },
    {
      "name": "AO_Command_Arbitration",
      "rungs": [
        {
          "comment": "Default scratch AO0=0 every scan; startup, fault, or a negative command selects low.",
          "instructions": [
            "LD P_On",
            "MOV(021) &0 D210"
          ]
        },
        {
          "comment": "Signed AO0 command within nominal 0..6000 is passed through.",
          "instructions": [
            "LD W0.04",
            "AND>=S(327) D200 &0",
            "AND<=S(317) D200 &6000",
            "MOV(021) D200 D210"
          ]
        },
        {
          "comment": "AO0 commands above 6000 are saturated; signed comparison prevents -1 from becoming a positive overrange.",
          "instructions": [
            "LD W0.04",
            "AND>S(322) D200 &6000",
            "MOV(021) &6000 D210"
          ]
        },
        {
          "comment": "Default scratch AO1=0 every scan; startup, fault, or a negative command selects low.",
          "instructions": [
            "LD P_On",
            "MOV(021) &0 D211"
          ]
        },
        {
          "comment": "Signed AO1 command within nominal 0..6000 is passed through.",
          "instructions": [
            "LD W0.04",
            "AND>=S(327) D201 &0",
            "AND<=S(317) D201 &6000",
            "MOV(021) D201 D211"
          ]
        },
        {
          "comment": "AO1 commands above 6000 are saturated; signed comparison prevents -1 from becoming a positive overrange.",
          "instructions": [
            "LD W0.04",
            "AND>S(322) D201 &6000",
            "MOV(021) &6000 D211"
          ]
        }
      ]
    },
    {
      "name": "Final_AO_Writers",
      "rungs": [
        {
          "comment": "Sole CIO210 writer; raw 0 means 0 V.",
          "instructions": [
            "LD P_On",
            "MOV(021) D210 210"
          ]
        },
        {
          "comment": "Sole CIO211 writer; raw 0 means 4 mA in the normal configuration.",
          "instructions": [
            "LD P_On",
            "MOV(021) D211 211"
          ]
        }
      ]
    }
  ],
