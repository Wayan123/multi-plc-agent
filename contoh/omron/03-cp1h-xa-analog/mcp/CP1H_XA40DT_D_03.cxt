   BEGIN
    SC:=6;
    Sec[0]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="Section1";
     ProgramData:=
     BEGIN
      RC:=0;
     END;
    END;
    Sec[1]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="Analog_Validity";
     ProgramData:=
     BEGIN
      RC:=5;
      R[0]:=
      BEGIN
       Com:="Valid AI0: ready, not first scan/error/#8000.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[4]
'  R0
LD A434.04
ANDNOT A315.14
ANDNOT A200.11
AND<>(305) 200 #8000
OUT W0.00
$?St$Bk?_#[4]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[1]:=
      BEGIN
       Com:="Valid AI1: ready, not first scan/error/#8000; reject open circuit.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[5]
'  R0
LD A434.04
ANDNOT A315.14
ANDNOT A200.11
AND<>(305) 201 #8000
ANDNOT A434.01
OUT W0.01
$?St$Bk?_#[5]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[2]:=
      BEGIN
       Com:="Valid AI2: ready, not first scan/error/#8000.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[6]
'  R0
LD A434.04
ANDNOT A315.14
ANDNOT A200.11
AND<>(305) 202 #8000
OUT W0.02
$?St$Bk?_#[6]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[3]:=
      BEGIN
       Com:="Valid AI3: ready, not first scan/error/#8000; reject open circuit.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[7]
'  R0
LD A434.04
ANDNOT A315.14
ANDNOT A200.11
AND<>(305) 203 #8000
ANDNOT A434.03
OUT W0.03
$?St$Bk?_#[7]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[4]:=
      BEGIN
       Com:="All AI channels must be valid to enable both AO channels; a fault on either channel drives both low.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[8]
'  R0
LD W0.00
AND W0.01
AND W0.02
AND W0.03
OUT W0.04
$?St$Bk?_#[8]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
     END;
    END;
    Sec[2]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="HMI_Input_Publication";
     ProgramData:=
     BEGIN
      RC:=8;
      R[0]:=
      BEGIN
       Com:="Clear the AI0 published value every scan; invalid data does not remain as a valid value.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[9]
'  R0
LD P_On
MOV(021) &0 D100
$?St$Bk?_#[9]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[1]:=
      BEGIN
       Com:="Copy AI0 only when validity is ON.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[10]
'  R0
LD W0.00
MOV(021) 200 D100
$?St$Bk?_#[10]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[2]:=
      BEGIN
       Com:="Clear the AI1 published value every scan; invalid data does not remain as a valid value.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[11]
'  R0
LD P_On
MOV(021) &0 D101
$?St$Bk?_#[11]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[3]:=
      BEGIN
       Com:="Copy AI1 only when validity is ON.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[12]
'  R0
LD W0.01
MOV(021) 201 D101
$?St$Bk?_#[12]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[4]:=
      BEGIN
       Com:="Clear the AI2 published value every scan; invalid data does not remain as a valid value.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[13]
'  R0
LD P_On
MOV(021) &0 D102
$?St$Bk?_#[13]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[5]:=
      BEGIN
       Com:="Copy AI2 only when validity is ON.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[14]
'  R0
LD W0.02
MOV(021) 202 D102
$?St$Bk?_#[14]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[6]:=
      BEGIN
       Com:="Clear the AI3 published value every scan; invalid data does not remain as a valid value.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[15]
'  R0
LD P_On
MOV(021) &0 D103
$?St$Bk?_#[15]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[7]:=
      BEGIN
       Com:="Copy AI3 only when validity is ON.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[16]
'  R0
LD W0.03
MOV(021) 203 D103
$?St$Bk?_#[16]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
     END;
    END;
    Sec[3]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="AO_Command_Arbitration";
     ProgramData:=
     BEGIN
      RC:=6;
      R[0]:=
      BEGIN
       Com:="Default scratch AO0=0 every scan; startup, fault, or a negative command selects low.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[17]
'  R0
LD P_On
MOV(021) &0 D210
$?St$Bk?_#[17]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[1]:=
      BEGIN
       Com:="Signed AO0 command within nominal 0..6000 is passed through.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[18]
'  R0
LD W0.04
AND>=S(327) D200 &0
AND<=S(317) D200 &6000
MOV(021) D200 D210
$?St$Bk?_#[18]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[2]:=
      BEGIN
       Com:="AO0 commands above 6000 are saturated; signed comparison prevents -1 from becoming a positive overrange.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[19]
'  R0
LD W0.04
AND>S(322) D200 &6000
MOV(021) &6000 D210
$?St$Bk?_#[19]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[3]:=
      BEGIN
       Com:="Default scratch AO1=0 every scan; startup, fault, or a negative command selects low.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[20]
'  R0
LD P_On
MOV(021) &0 D211
$?St$Bk?_#[20]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[4]:=
      BEGIN
       Com:="Signed AO1 command within nominal 0..6000 is passed through.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[21]
'  R0
LD W0.04
AND>=S(327) D201 &0
AND<=S(317) D201 &6000
MOV(021) D201 D211
$?St$Bk?_#[21]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[5]:=
      BEGIN
       Com:="AO1 commands above 6000 are saturated; signed comparison prevents -1 from becoming a positive overrange.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[22]
'  R0
LD W0.04
AND>S(322) D201 &6000
MOV(021) &6000 D211
$?St$Bk?_#[22]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
     END;
    END;
    Sec[4]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="Final_AO_Writers";
     ProgramData:=
     BEGIN
      RC:=2;
      R[0]:=
      BEGIN
       Com:="Sole CIO210 writer; raw 0 means 0 V.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[23]
'  R0
LD P_On
MOV(021) D210 210
$?St$Bk?_#[23]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[1]:=
      BEGIN
       Com:="Sole CIO211 writer; raw 0 means 4 mA in the normal configuration.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[24]
'  R0
LD P_On
MOV(021) D211 211
$?St$Bk?_#[24]
       AtchCmts:=
