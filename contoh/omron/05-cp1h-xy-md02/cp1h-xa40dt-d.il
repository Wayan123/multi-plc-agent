; SECTION XY_MD02
; RUNG 1: Startup: reset application state, never reset the system execution bit
LD A200.11
MOV(021) #0000 D100
MOV(021) #0000 D101
MOV(021) #0000 D102
MOV(021) #0000 D103

; RUNG 2: Mask byte count without modifying the live response
LD P_On
ANDW(034) D32254 #FF00 D114

; RUNG 3: Owned completion is evaluated BEFORE any new request
LD W20.00
ANDNOT A641.00
ANDNOT A200.11
OUT W21.00

; RUNG 4: Validate success flags, ID, function, length and byte count
LD W21.00
AND A641.01
ANDNOT A641.02
AND=(300) D32250 #0001
AND=(300) D32251 #0004
AND=(300) D32252 #0000
AND=(300) D32253 #0005
AND=(300) D114 #0400
OUT W21.01

; RUNG 5: Completed but not valid: includes protocol shape errors
LD W21.00
ANDNOT W21.01
OUT W21.02

; RUNG 6: Preserve raw Omron execution error separately
LD W21.00
MOV(021) D32252 D102

; RUNG 7: Assemble signed temperature and humidity from fresh scratch bytes
LD W21.01
ANDW(034) D32254 #00FF D110
SWAP(637) &1 D110
ANDW(034) D32255 #FF00 D111
SWAP(637) &1 D111
ORW(035) D110 D111 D100
ANDW(034) D32255 #00FF D112
SWAP(637) &1 D112
ANDW(034) D32256 #FF00 D113
SWAP(637) &1 D113
ORW(035) D112 D113 D101
MOV(021) #0000 D103

; RUNG 8: Application response or completion validation error; not an Omron error code
LD W21.02
ANDNOT A641.02
MOV(021) #0001 D103

; RUNG 9: A system-reported slave or transport error is not an application validation error
LD W21.02
AND A641.02
MOV(021) #0000 D103

; RUNG 10: Wait one second BETWEEN completed requests; do not overlap the 5s system timeout
LD W10.00
ANDNOT W20.00
ANDNOT W21.00
TIM 0001 #0010

; RUNG 11: Start only when application AND system are idle
LD W10.00
AND T0001
ANDNOT W20.00
ANDNOT A641.00
ANDNOT A200.11
OUT W21.03

; RUNG 12: FC04 input-register read: wire start 0001 quantity 0002, CRC generated by PLC
LD W21.03
MOV(021) #0000 D103
MOV(021) #0001 D32200
MOV(021) #0004 D32201
MOV(021) #0004 D32202
MOV(021) #0001 D32203
MOV(021) #0002 D32204
SET A641.00

; RUNG 13: One writer: owned transaction next state
LD W20.00
ANDNOT W21.00
OR W21.03
ANDNOT A200.11
OUT W20.00

; RUNG 14: One writer: fresh values valid only after success and while enabled
LD W20.01
OR W21.01
ANDNOT W21.02
ANDNOT W21.03
AND W10.00
ANDNOT A200.11
OUT W20.01

; RUNG 15: One writer: retain last failure until next poll
LD W20.02
OR W21.02
ANDNOT W21.03
ANDNOT A200.11
OUT W20.02

