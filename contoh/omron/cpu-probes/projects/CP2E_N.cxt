    Sec[1]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="Instruction_Probe";
     ProgramData:=
     BEGIN
      RC:=11;
      R[0]:=
      BEGIN
       Com:="Binary 100 ms timer; decimal preset 10 is one second.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[6]
'  R0
LD W0.00
TIMX(550) 000 &10
$?St$Bk?_#[6]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[1]:=
      BEGIN
       Com:="Binary down counter; reset dominates count and initializes on first cycle.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[7]
'  R0
LD W0.01
LD W0.02
OR P_First_Cycle
CNTX(546) 001 &3
$?St$Bk?_#[7]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[2]:=
      BEGIN
       Com:="Expose timer completion in an internal bit, not a physical output.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[8]
'  R0
LD T000
OUT W0.03
$?St$Bk?_#[8]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[3]:=
      BEGIN
       Com:="Expose counter completion in an internal bit.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[9]
'  R0
LD C001
OUT W0.04
$?St$Bk?_#[9]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[4]:=
      BEGIN
       Com:="One-cycle rising-edge pulse.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[10]
'  R0
LD W0.05
DIFU(013) W0.06
$?St$Bk?_#[10]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[5]:=
      BEGIN
       Com:="One-cycle falling-edge pulse.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[11]
'  R0
LD W0.05
DIFD(014) W0.07
$?St$Bk?_#[11]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[6]:=
      BEGIN
       Com:="Reset-dominant internal latch; initialized off on the first cycle.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[12]
'  R0
LD W0.08
LD W0.09
OR P_First_Cycle
KEEP(011) W0.10
$?St$Bk?_#[12]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[7]:=
      BEGIN
       Com:="Inverted internal output.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[13]
'  R0
LD W0.05
OUTNOT W0.11
$?St$Bk?_#[13]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[8]:=
      BEGIN
       Com:="Read the last work bit and write the last holding bit. No physical I/O.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[14]
'  R0
LD W127.15
OUT H127.15
$?St$Bk?_#[14]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[9]:=
      BEGIN
       Com:="Write a constant to the last data-memory word. Offline synthetic example only.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[15]
'  R0
LD P_On
MOV(021) &1234 D16383
$?St$Bk?_#[15]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[10]:=
      BEGIN
       Com:="";
       Flags:="1,0";
       FBversion:="";
       SL:="";
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
