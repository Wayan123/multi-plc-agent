CXProgVer:="1.5";
WrittenByCXPVersion:="9.73";
FileType:=1;
Name:="OmronTeachingExample";
Core:=
BEGIN
 CDMPath:="";
END;
ResourceCount:=1;
Resource[0]:=
BEGIN
 Name:="ExampleResource";
 PLC:=
 BEGIN
  Name:="ExamplePLC";
  Config:="[DEV]DEV:CP1H;CPU:XA;CLOCK:TRUE;GATE:TRUE;REMOTE:TRUE;UM:UM,0,43008,WORD,RW,1,RAM;";
 END;
 GlobalVariables:=
 BEGIN
  VariableList:=
  BEGIN_LIST_$#[1]
  END_LIST_$#[1];
  VariableCount:=0;
 END;
 Programs:=
 BEGIN
  Program[0]:=
  BEGIN
   Name:="Main";
   FileType:=2;
   LocalVariables:=
   BEGIN
    VariableList:=
    BEGIN_LIST_$#[2]
    END_LIST_$#[2];
    VariableCount:=0;
   END;
   TaskID:=256;
   OpStart:=1;
   Sections:=
   BEGIN
    SC:=8;
    Sec[0]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="Section1";
     ProgramData:=
     BEGIN
      RC:=0;
     END;
    END;
    Sec[1]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="Signed32_Constants";
     ProgramData:=
     BEGIN
      RC:=2;
      R[0]:=
      BEGIN
       Com:="Fixed signed32 divisor; MOVL writes both low and high words instead of reading an unknown high word from the next address.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[4]
'  R0
LD P_On
MOVL(498) &6000 D170
$?St$Bk?_#[4]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[1]:=
      BEGIN
       Com:="Signed32 divisor/offset=1000; the high word is set to 0 every scan.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[5]
'  R0
LD P_On
MOVL(498) &1000 D172
$?St$Bk?_#[5]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
     END;
    END;
    Sec[2]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="Analog_Validity";
     ProgramData:=
     BEGIN
      RC:=5;
      R[0]:=
      BEGIN
       Com:="Valid AI0: ready, not first scan/error/#8000.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[6]
'  R0
LD A434.04
ANDNOT A315.14
ANDNOT A200.11
AND<>(305) 200 #8000
OUT W0.00
$?St$Bk?_#[6]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[1]:=
      BEGIN
       Com:="Valid AI1: ready, not first scan/error/#8000; reject open circuit.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[7]
'  R0
LD A434.04
ANDNOT A315.14
ANDNOT A200.11
AND<>(305) 201 #8000
ANDNOT A434.01
OUT W0.01
$?St$Bk?_#[7]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[2]:=
      BEGIN
       Com:="Valid AI2: ready, not first scan/error/#8000.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[8]
'  R0
LD A434.04
ANDNOT A315.14
ANDNOT A200.11
AND<>(305) 202 #8000
OUT W0.02
$?St$Bk?_#[8]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[3]:=
      BEGIN
       Com:="Valid AI3: ready, not first scan/error/#8000; reject open circuit.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[9]
'  R0
LD A434.04
ANDNOT A315.14
ANDNOT A200.11
AND<>(305) 203 #8000
ANDNOT A434.03
OUT W0.03
$?St$Bk?_#[9]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[4]:=
      BEGIN
       Com:="All AI channels must be valid to enable both AO channels; a fault on either channel drives both low.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[10]
'  R0
LD W0.00
AND W0.01
AND W0.02
AND W0.03
OUT W0.04
$?St$Bk?_#[10]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
     END;
    END;
    Sec[3]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="HMI_Input_Publication";
     ProgramData:=
     BEGIN
      RC:=8;
      R[0]:=
      BEGIN
       Com:="Clear the AI0 published value every scan; invalid data does not remain as a valid value.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[11]
'  R0
LD P_On
MOV(021) &0 D100
$?St$Bk?_#[11]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[1]:=
      BEGIN
       Com:="Copy AI0 only when validity is ON.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[12]
'  R0
LD W0.00
MOV(021) 200 D100
$?St$Bk?_#[12]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[2]:=
      BEGIN
       Com:="Clear the AI1 published value every scan; invalid data does not remain as a valid value.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[13]
'  R0
LD P_On
MOV(021) &0 D101
$?St$Bk?_#[13]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[3]:=
      BEGIN
       Com:="Copy AI1 only when validity is ON.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[14]
'  R0
LD W0.01
MOV(021) 201 D101
$?St$Bk?_#[14]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[4]:=
      BEGIN
       Com:="Clear the AI2 published value every scan; invalid data does not remain as a valid value.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[15]
'  R0
LD P_On
MOV(021) &0 D102
$?St$Bk?_#[15]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[5]:=
      BEGIN
       Com:="Copy AI2 only when validity is ON.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[16]
'  R0
LD W0.02
MOV(021) 202 D102
$?St$Bk?_#[16]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[6]:=
      BEGIN
       Com:="Clear the AI3 published value every scan; invalid data does not remain as a valid value.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[17]
'  R0
LD P_On
MOV(021) &0 D103
$?St$Bk?_#[17]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[7]:=
      BEGIN
       Com:="Copy AI3 only when validity is ON.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[18]
'  R0
LD W0.03
MOV(021) 203 D103
$?St$Bk?_#[18]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
     END;
    END;
    Sec[4]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="Math_Defaults_Each_Scan";
     ProgramData:=
     BEGIN
      RC:=8;
      R[0]:=
      BEGIN
       Com:="Default input clamp to 0 every scan.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[19]
'  R0
LD P_On
MOV(021) &0 D104
$?St$Bk?_#[19]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[1]:=
      BEGIN
       Com:="Clear the input product word pair; invalid data leaves no stale published value or quotient.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[20]
'  R0
LD P_On
MOVL(498) &0 D110
$?St$Bk?_#[20]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[2]:=
      BEGIN
       Com:="Clear the input quotient word pair; invalid data leaves no stale published value or quotient.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[21]
'  R0
LD P_On
MOVL(498) &0 D120
$?St$Bk?_#[21]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[3]:=
      BEGIN
       Com:="Clear the input remainder word pair; invalid data leaves no stale published value or quotient.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[22]
'  R0
LD P_On
MOVL(498) &0 D122
$?St$Bk?_#[22]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[4]:=
      BEGIN
       Com:="Clear the engineering value word pair; invalid data leaves no stale published value or quotient.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[23]
'  R0
LD P_On
MOVL(498) &0 D130
$?St$Bk?_#[23]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[5]:=
      BEGIN
       Com:="Clear the output product word pair; invalid data leaves no stale published value or quotient.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[24]
'  R0
LD P_On
MOVL(498) &0 D150
$?St$Bk?_#[24]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[6]:=
      BEGIN
       Com:="Clear the output quotient word pair; invalid data leaves no stale published value or quotient.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[25]
'  R0
LD P_On
MOVL(498) &0 D160
$?St$Bk?_#[25]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[7]:=
      BEGIN
       Com:="Clear the output remainder word pair; invalid data leaves no stale published value or quotient.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[26]
'  R0
LD P_On
MOVL(498) &0 D162
$?St$Bk?_#[26]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
     END;
    END;
    Sec[5]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="Signed32_Input_Scaling";
     ProgramData:=
     BEGIN
      RC:=7;
      R[0]:=
      BEGIN
       Com:="Only valid AI0 may enter the scaling path.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[27]
'  R0
LD W0.00
MOV(021) D100 D104
$?St$Bk?_#[27]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[1]:=
      BEGIN
       Com:="Clamp negative extended signed input before multiplication.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[28]
'  R0
LD W0.00
AND<S(312) D100 &0
MOV(021) &0 D104
$?St$Bk?_#[28]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[2]:=
      BEGIN
       Com:="Clamp signed input above nominal 6000 before multiplication.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[29]
'  R0
LD W0.00
AND>S(322) D100 &6000
MOV(021) &6000 D104
$?St$Bk?_#[29]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[3]:=
      BEGIN
       Com:="Signed16 x signed16 -> signed32; the maximum product 12000000 exceeds 16 bits.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[30]
'  R0
LD W0.00
*(420) D104 &2000 D110
$?St$Bk?_#[30]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[4]:=
      BEGIN
       Com:="Divide signed32 by the divisor pair 6000; reserve D120..123 for quotient and remainder.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[31]
'  R0
LD W0.00
/L(431) D110 D170 D120
$?St$Bk?_#[31]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[5]:=
      BEGIN
       Com:="Quotient 0..2000 minus signed32 offset 1000 -> engineering -1000..1000.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[32]
'  R0
LD W0.00
-L(411) D120 D172 D130
$?St$Bk?_#[32]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[6]:=
      BEGIN
       Com:="Engineering value is valid only when AI0 is valid; default zero is not a valid measurement.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[33]
'  R0
LD W0.00
OUT W0.05
$?St$Bk?_#[33]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
     END;
    END;
    Sec[6]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="Output_Scaling_And_Final_Writer";
     ProgramData:=
     BEGIN
      RC:=7;
      R[0]:=
      BEGIN
       Com:="Command defaults to 0; the fault gate and negative commands select low.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[34]
'  R0
LD P_On
MOV(021) &0 D140
$?St$Bk?_#[34]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[1]:=
      BEGIN
       Com:="Command 0..1000 passes after signed clamping when all AI channels are valid.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[35]
'  R0
LD W0.04
AND>=S(327) D200 &0
AND<=S(317) D200 &1000
MOV(021) D200 D140
$?St$Bk?_#[35]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[2]:=
      BEGIN
       Com:="Commands above 1000 are saturated before multiplication.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[36]
'  R0
LD W0.04
AND>S(322) D200 &1000
MOV(021) &1000 D140
$?St$Bk?_#[36]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[3]:=
      BEGIN
       Com:="Signed16 x signed16 -> signed32; maximum 6000000, not 16-bit.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[37]
'  R0
LD W0.04
*(420) D140 &6000 D150
$?St$Bk?_#[37]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[4]:=
      BEGIN
       Com:="Signed32 division uses D172..173=1000; all of D160..163 is allocated.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[38]
'  R0
LD W0.04
/L(431) D150 D172 D160
$?St$Bk?_#[38]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[5]:=
      BEGIN
       Com:="Sole AO0 writer; quotient low 0..6000, default 0 when invalid.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[39]
'  R0
LD P_On
MOV(021) D160 210
$?St$Bk?_#[39]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
      R[6]:=
      BEGIN
       Com:="Sole AO1 writer; raw 0 means 4 mA, not 0 mA.";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[40]
'  R0
LD P_On
MOV(021) D160 211
$?St$Bk?_#[40]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
     END;
    END;
    Sec[7]:=
    BEGIN
     IEC1131Type:=11;
     CompileInline:=0;
     SecType:=0;
     SecName:="END";
     ProgramData:=
     BEGIN
      RC:=1;
      R[0]:=
      BEGIN
       Com:="";
       Flags:="1,0";
       FBversion:="";
       SL:=
$?St$Bk?_#[3]
END(001)
$?St$Bk?_#[3]
       AtchCmts:=
       BEGIN
        CC:=0;
       END;
      END;
     END;
    END;
   END;
  END;
 END;
END;
