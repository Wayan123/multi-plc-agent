{
  "schema_version": 1,
  "id": "04-analog-scaling",
  "model": "CP1H-XA40DT-D",
  "device": "CP1H",
  "cpu": "XA",
  "sections": [
    {
      "name": "Signed32_Constants",
      "rungs": [
        {
          "comment": "Fixed signed32 divisor; MOVL writes both low and high words instead of reading an unknown high word from the next address.",
          "instructions": [
            "LD P_On",
            "MOVL(498) &6000 D170"
          ]
        },
        {
          "comment": "Signed32 divisor/offset=1000; the high word is set to 0 every scan.",
          "instructions": [
            "LD P_On",
            "MOVL(498) &1000 D172"
          ]
        }
      ]
    },
    {
      "name": "Analog_Validity",
      "rungs": [
        {
          "comment": "Valid AI0: ready, not first scan/error/#8000.",
          "instructions": [
            "LD A434.04",
            "ANDNOT A315.14",
            "ANDNOT A200.11",
            "AND<>(305) 200 #8000",
            "OUT W0.00"
          ]
        },
        {
          "comment": "Valid AI1: ready, not first scan/error/#8000; reject open circuit.",
          "instructions": [
            "LD A434.04",
            "ANDNOT A315.14",
            "ANDNOT A200.11",
            "AND<>(305) 201 #8000",
            "ANDNOT A434.01",
            "OUT W0.01"
          ]
        },
        {
          "comment": "Valid AI2: ready, not first scan/error/#8000.",
          "instructions": [
            "LD A434.04",
            "ANDNOT A315.14",
            "ANDNOT A200.11",
            "AND<>(305) 202 #8000",
            "OUT W0.02"
          ]
        },
        {
          "comment": "Valid AI3: ready, not first scan/error/#8000; reject open circuit.",
          "instructions": [
            "LD A434.04",
            "ANDNOT A315.14",
            "ANDNOT A200.11",
            "AND<>(305) 203 #8000",
            "ANDNOT A434.03",
            "OUT W0.03"
          ]
        },
        {
          "comment": "All AI channels must be valid to enable both AO channels; a fault on either channel drives both low.",
          "instructions": [
            "LD W0.00",
            "AND W0.01",
            "AND W0.02",
            "AND W0.03",
            "OUT W0.04"
          ]
        }
      ]
    },
    {
      "name": "HMI_Input_Publication",
      "rungs": [
        {
          "comment": "Clear the AI0 published value every scan; invalid data does not remain as a valid value.",
          "instructions": [
            "LD P_On",
            "MOV(021) &0 D100"
          ]
        },
        {
          "comment": "Copy AI0 only when validity is ON.",
          "instructions": [
            "LD W0.00",
            "MOV(021) 200 D100"
          ]
        },
        {
          "comment": "Clear the AI1 published value every scan; invalid data does not remain as a valid value.",
          "instructions": [
            "LD P_On",
            "MOV(021) &0 D101"
          ]
        },
        {
          "comment": "Copy AI1 only when validity is ON.",
          "instructions": [
            "LD W0.01",
            "MOV(021) 201 D101"
          ]
        },
        {
          "comment": "Clear the AI2 published value every scan; invalid data does not remain as a valid value.",
          "instructions": [
            "LD P_On",
            "MOV(021) &0 D102"
          ]
        },
        {
          "comment": "Copy AI2 only when validity is ON.",
          "instructions": [
            "LD W0.02",
            "MOV(021) 202 D102"
          ]
        },
        {
          "comment": "Clear the AI3 published value every scan; invalid data does not remain as a valid value.",
          "instructions": [
            "LD P_On",
            "MOV(021) &0 D103"
          ]
        },
        {
          "comment": "Copy AI3 only when validity is ON.",
          "instructions": [
            "LD W0.03",
            "MOV(021) 203 D103"
          ]
        }
      ]
    },
    {
      "name": "Math_Defaults_Each_Scan",
      "rungs": [
        {
          "comment": "Default input clamp to 0 every scan.",
          "instructions": [
            "LD P_On",
            "MOV(021) &0 D104"
          ]
        },
        {
          "comment": "Clear the input product word pair; invalid data leaves no stale published value or quotient.",
          "instructions": [
            "LD P_On",
            "MOVL(498) &0 D110"
          ]
        },
        {
          "comment": "Clear the input quotient word pair; invalid data leaves no stale published value or quotient.",
          "instructions": [
            "LD P_On",
            "MOVL(498) &0 D120"
          ]
        },
        {
          "comment": "Clear the input remainder word pair; invalid data leaves no stale published value or quotient.",
          "instructions": [
            "LD P_On",
            "MOVL(498) &0 D122"
          ]
        },
        {
          "comment": "Clear the engineering value word pair; invalid data leaves no stale published value or quotient.",
          "instructions": [
            "LD P_On",
            "MOVL(498) &0 D130"
          ]
        },
        {
          "comment": "Clear the output product word pair; invalid data leaves no stale published value or quotient.",
          "instructions": [
            "LD P_On",
            "MOVL(498) &0 D150"
          ]
        },
        {
          "comment": "Clear the output quotient word pair; invalid data leaves no stale published value or quotient.",
          "instructions": [
            "LD P_On",
            "MOVL(498) &0 D160"
          ]
        },
        {
          "comment": "Clear the output remainder word pair; invalid data leaves no stale published value or quotient.",
          "instructions": [
            "LD P_On",
            "MOVL(498) &0 D162"
          ]
        }
      ]
    },
    {
      "name": "Signed32_Input_Scaling",
      "rungs": [
        {
          "comment": "Only valid AI0 may enter the scaling path.",
          "instructions": [
            "LD W0.00",
            "MOV(021) D100 D104"
          ]
        },
        {
          "comment": "Clamp negative extended signed input before multiplication.",
          "instructions": [
            "LD W0.00",
            "AND<S(312) D100 &0",
            "MOV(021) &0 D104"
          ]
        },
        {
          "comment": "Clamp signed input above nominal 6000 before multiplication.",
          "instructions": [
            "LD W0.00",
            "AND>S(322) D100 &6000",
            "MOV(021) &6000 D104"
          ]
        },
        {
          "comment": "Signed16 x signed16 -> signed32; the maximum product 12000000 exceeds 16 bits.",
          "instructions": [
            "LD W0.00",
            "*(420) D104 &2000 D110"
          ]
        },
        {
          "comment": "Divide signed32 by the divisor pair 6000; reserve D120..123 for quotient and remainder.",
          "instructions": [
            "LD W0.00",
            "/L(431) D110 D170 D120"
          ]
        },
        {
          "comment": "Quotient 0..2000 minus signed32 offset 1000 -> engineering -1000..1000.",
          "instructions": [
            "LD W0.00",
            "-L(411) D120 D172 D130"
          ]
        },
        {
          "comment": "Engineering value is valid only when AI0 is valid; default zero is not a valid measurement.",
          "instructions": [
            "LD W0.00",
            "OUT W0.05"
          ]
        }
      ]
    },
    {
      "name": "Output_Scaling_And_Final_Writer",
      "rungs": [
        {
          "comment": "Command defaults to 0; the fault gate and negative commands select low.",
          "instructions": [
            "LD P_On",
            "MOV(021) &0 D140"
          ]
        },
        {
          "comment": "Command 0..1000 passes after signed clamping when all AI channels are valid.",
          "instructions": [
            "LD W0.04",
            "AND>=S(327) D200 &0",
            "AND<=S(317) D200 &1000",
            "MOV(021) D200 D140"
          ]
        },
        {
          "comment": "Commands above 1000 are saturated before multiplication.",
          "instructions": [
            "LD W0.04",
            "AND>S(322) D200 &1000",
            "MOV(021) &1000 D140"
          ]
        },
        {
          "comment": "Signed16 x signed16 -> signed32; maximum 6000000, not 16-bit.",
          "instructions": [
            "LD W0.04",
            "*(420) D140 &6000 D150"
          ]
        },
        {
          "comment": "Signed32 division uses D172..173=1000; all of D160..163 is allocated.",
          "instructions": [
            "LD W0.04",
            "/L(431) D150 D172 D160"
          ]
        },
        {
          "comment": "Sole AO0 writer; quotient low 0..6000, default 0 when invalid.",
          "instructions": [
            "LD P_On",
            "MOV(021) D160 210"
          ]
        },
        {
          "comment": "Sole AO1 writer; raw 0 means 4 mA, not 0 mA.",
          "instructions": [
            "LD P_On",
            "MOV(021) D160 211"
          ]
        }
      ]
    }
  ],
