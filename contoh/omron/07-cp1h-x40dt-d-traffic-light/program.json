          ]
        },
        {
          "comment": "Pedestrian red output.",
          "instructions": [
            "LD<> D0 #0007",
            "OUT 101.04"
          ]
        },
        {
          "comment": "Pedestrian green output.",
          "instructions": [
            "LD= D0 #0007",
            "OUT 101.05"
          ]
        }
      ]
    }
