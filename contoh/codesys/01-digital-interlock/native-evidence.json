      "logic": [
        {
          "comment": "Arm after start release with all permissives healthy",
          "kind": "OUT",
          "target": "Armed",
          "logic": "(Armed AND EStopHealthy AND GuardHealthy AND StopHealthy) OR (EStopHealthy AND GuardHealthy AND NOT StartPB AND StopHealthy)"
        },
        {
          "comment": "Seal in run; permissive loss immediately drops run",
          "kind": "OUT",
          "target": "RunRequest",
          "logic": "(Armed AND EStopHealthy AND GuardHealthy AND StartPB AND StopHealthy) OR (EStopHealthy AND GuardHealthy AND RunRequest AND StopHealthy)"
        },
        {
          "comment": "Three-second start warning delay",
          "kind": "TON",
          "target": "StartDelay",
          "logic": "RunRequest",
          "params": {
            "PT": "T#3S"
          }
        },
        {
          "comment": "Horn sounds only while the start delay is incomplete",
          "kind": "OUT",
          "target": "Horn",
          "logic": "NOT StartDelay.Q AND RunRequest"
        },
        {
          "comment": "Motor starts only after the warning delay",
          "kind": "OUT",
          "target": "Motor",
          "logic": "RunRequest AND StartDelay.Q"
        }
      ]
    }
